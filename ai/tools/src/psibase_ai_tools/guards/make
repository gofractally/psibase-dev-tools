#!/usr/bin/env bash
set -euo pipefail

if [[ "${AI_DEV_TOOL_ACTIVE:-0}" != "1" ]]; then
    echo "ERROR: Direct 'make' invocation is not permitted outside ai-tools managed runs." >&2
    echo "Use: ai-tools run build_package / ai-tools run run_full_build (or ai-tools team build)." >&2
    exit 97
fi

for candidate in /usr/bin/make /usr/local/bin/make /bin/make; do
    if [[ -x "$candidate" ]]; then
        exec "$candidate" "$@"
    fi
done

echo "ERROR: Unable to locate the real make binary." >&2
exit 127

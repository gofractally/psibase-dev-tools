#!/usr/bin/env bash
set -euo pipefail

if [[ "${AI_DEV_TOOL_ACTIVE:-0}" != "1" ]]; then
    echo "ERROR: Direct 'cmake' invocation is not permitted outside ai-tools managed runs." >&2
    echo "Use: run <tool_name> (for example: run build_rust_service)" >&2
    exit 97
fi

for candidate in /usr/bin/cmake /usr/local/bin/cmake /bin/cmake; do
    if [[ -x "$candidate" ]]; then
        exec "$candidate" "$@"
    fi
done

echo "ERROR: Unable to locate the real cmake binary." >&2
exit 127

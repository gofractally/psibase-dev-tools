#!/usr/bin/env bash
set -euo pipefail

if [[ "${AI_DEV_TOOL_ACTIVE:-0}" != "1" ]]; then
    echo "ERROR: Direct 'ctest' invocation is not permitted outside ai-tools managed runs." >&2
    echo "Use: run <tool_name> via approved wrapper flow." >&2
    exit 97
fi

for candidate in /usr/bin/ctest /usr/local/bin/ctest /bin/ctest; do
    if [[ -x "$candidate" ]]; then
        exec "$candidate" "$@"
    fi
done

echo "ERROR: Unable to locate the real ctest binary." >&2
exit 127

#!/usr/bin/env bash
set -euo pipefail

if [[ "${AI_DEV_TOOL_ACTIVE:-0}" != "1" ]]; then
    echo "ERROR: Direct 'ctest' invocation is not permitted outside ai-tools managed runs." >&2
    echo "Use: ai-tools run <tool_name> via the approved wrapper flow." >&2
    exit 97
fi

# Exec the next 'ctest' on PATH, skipping this guard directory.
guard_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
while IFS= read -r candidate; do
    if [[ "$(cd "$(dirname "$candidate")" && pwd)" != "$guard_dir" ]]; then
        exec "$candidate" "$@"
    fi
done < <(type -aP ctest)

echo "ERROR: Unable to locate the real ctest binary on PATH." >&2
exit 127

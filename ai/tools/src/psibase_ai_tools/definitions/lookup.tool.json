{
  "$schema": "./tool-definition.schema.json",
  "name": "lookup",
  "version": "1.0.0",
  "description": "Lookup concise psibase-specific implementation guidance from tagged knowledge snippets.",
  "executor": {
    "type": "python",
    "path": "../executors/lookup.py"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "description": "Short keyword query for point-of-need guidance."
      },
      "top_k": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "default": 3,
        "description": "Maximum number of matching snippets to return."
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "tool",
      "status",
      "query",
      "top_k",
      "matches",
      "summary",
      "error_code",
      "error_category"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "tool": {
        "type": "string",
        "const": "lookup"
      },
      "status": {
        "type": "string",
        "enum": [
          "passed",
          "error"
        ]
      },
      "query": {
        "type": "string"
      },
      "top_k": {
        "type": "integer",
        "minimum": 1
      },
      "matches": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "title",
            "tags",
            "score",
            "content"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "score": {
              "type": "integer",
              "minimum": 0
            },
            "content": {
              "type": "string"
            }
          }
        }
      },
      "summary": {
        "type": "string"
      },
      "error_code": {
        "type": [
          "string",
          "null"
        ]
      },
      "error_category": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "errors": [
    {
      "code": "invalid_input",
      "description": "Input failed schema or required value checks."
    },
    {
      "code": "knowledge_index_missing",
      "description": "knowledge/index.json is missing or unreadable."
    },
    {
      "code": "invalid_index",
      "description": "knowledge/index.json has invalid structure."
    },
    {
      "code": "snippet_read_failed",
      "description": "A snippet referenced by the index is missing or unreadable."
    }
  ]
}

{
  "$schema": "./tool-definition.schema.json",
  "name": "run_full_build",
  "version": "1.0.0",
  "description": "Run the canonical psibase full baseline build (configure-if-needed + make install).",
  "executor": {
    "type": "python",
    "path": "../lib/run_full_build.py"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspace_root": {
        "type": "string",
        "description": "Absolute path to the psibase repo. Defaults to the auto-detected workspace root."
      },
      "build_dir": {
        "type": "string",
        "default": "build",
        "description": "Absolute path or workspace-relative build directory."
      },
      "configure_if_needed": {
        "type": "boolean",
        "default": true
      },
      "cmake_args": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional override for baseline cmake flags."
      },
      "install_target": {
        "type": "string",
        "default": "install"
      },
      "jobs": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "tool",
      "status",
      "command_sequence",
      "workspace_root",
      "build_dir",
      "configured_this_run",
      "summary",
      "stdout",
      "stderr",
      "exit_code"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "tool": {
        "type": "string",
        "const": "run_full_build"
      },
      "status": {
        "type": "string",
        "enum": [
          "passed",
          "failed",
          "error"
        ]
      },
      "workspace_root": {
        "type": "string"
      },
      "build_dir": {
        "type": "string"
      },
      "configured_this_run": {
        "type": "boolean"
      },
      "jobs": {
        "type": "integer"
      },
      "command_sequence": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "duration_seconds": {
        "type": [
          "number",
          "null"
        ]
      },
      "parse_quality": {
        "type": "string",
        "enum": [
          "strict_prefix"
        ],
        "description": "How build diagnostic counts were parsed."
      },
      "error_count": {
        "type": "integer",
        "minimum": 0,
        "description": "Strict prefix-classified build error line count."
      },
      "warning_count": {
        "type": "integer",
        "minimum": 0,
        "description": "Strict prefix-classified build warning line count."
      },
      "error_word_hits": {
        "type": "integer",
        "minimum": 0,
        "description": "Raw case-insensitive word hits for debugging only; may include library names or prose."
      },
      "warning_word_hits": {
        "type": "integer",
        "minimum": 0,
        "description": "Raw case-insensitive word hits for debugging only; may include library names or prose."
      },
      "summary": {
        "type": "string"
      },
      "error_code": {
        "type": [
          "string",
          "null"
        ]
      },
      "error_category": {
        "type": [
          "string",
          "null"
        ]
      },
      "failure_excerpt": {
        "type": [
          "string",
          "null"
        ]
      },
      "stdout": {
        "type": "string"
      },
      "stderr": {
        "type": "string"
      },
      "exit_code": {
        "type": [
          "integer",
          "null"
        ]
      }
    }
  },
  "errors": [
    {
      "code": "invalid_input",
      "description": "Input failed schema or required value checks."
    },
    {
      "code": "environment_missing",
      "description": "Required executable is missing."
    },
    {
      "code": "build_dir_missing",
      "description": "Build directory does not exist and auto-configure is disabled."
    },
    {
      "code": "cmake_not_configured",
      "description": "Build directory is not configured and auto-configure is disabled."
    },
    {
      "code": "cmake_config_failed",
      "description": "CMake configure step failed."
    },
    {
      "code": "build_failed",
      "description": "Full build failed."
    },
    {
      "code": "resource_busy",
      "description": "Another build job already holds the lock on build_dir. Use the holder PID/job_id surfaced in the result to investigate, or pass a distinct build_dir."
    }
  ]
}
